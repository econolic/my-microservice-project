# AWS Configuration
aws_region = "us-west-2"

# S3 Backend Configuration
backend_bucket_name = "terraform-state-budyakov-lesson8-9"
backend_table_name  = "terraform-locks-lesson8-9"

# VPC Configuration
vpc_name               = "lesson-8-9-vpc"
vpc_cidr               = "10.0.0.0/16"
availability_zones     = ["us-west-2a", "us-west-2b", "us-west-2c"]
public_subnet_cidrs    = ["10.0.1.0/24", "10.0.2.0/24", "10.0.3.0/24"]
private_subnet_cidrs   = ["10.0.4.0/24", "10.0.5.0/24", "10.0.6.0/24"]

# ECR Configuration
ecr_repository_name = "django-app-lesson8-9"

# EKS Configuration
cluster_name        = "lesson-8-9-eks-cluster"
cluster_version     = "1.28"
node_group_name     = "lesson-8-9-node-group"
node_instance_types = ["t3.medium"]
node_min_size       = 2
node_desired_size   = 2
node_max_size       = 4

# Jenkins Configuration
jenkins_namespace       = "jenkins"
jenkins_chart_version   = "5.7.0"
jenkins_admin_password  = "Admin123!"  # Change this to a secure password
jenkins_service_type    = "LoadBalancer"
jenkins_storage_size    = "10Gi"

# Argo CD Configuration
argocd_namespace     = "argocd"
argocd_chart_version = "7.7.1"
argocd_service_type  = "LoadBalancer"
argocd_auto_sync     = true
argocd_self_heal     = true

# GitHub Configuration
github_token    = "ghp_your_github_token_here"  # Replace with your GitHub token
github_username = "your-github-username"         # Replace with your GitHub username
github_repo_url = "https://github.com/your-github-username/my-microservice-project.git"  # Replace with your repo URL
helm_chart_path = "charts/django-app"

# Common Tags
tags = {
  Project     = "MyMicroservice"
  Lesson      = "8-9"
  Environment = "development"
  ManagedBy   = "Terraform"
}

# ========================================
# RDS/Database Configuration
# ========================================

# Basic Database Settings
rds_identifier      = "lesson-db-postgres"      # Database identifier
rds_use_aurora      = false                     # false = Standard RDS, true = Aurora Cluster
rds_engine          = "postgres"                # postgres, mysql, aurora-postgresql, aurora-mysql
rds_engine_version  = "16.1"                    # Database engine version
rds_instance_class  = "db.t3.micro"             # Instance class (db.t3.micro for free tier)

# Storage Configuration (Standard RDS only)
rds_allocated_storage = 20                      # Storage size in GB
rds_storage_type      = "gp3"                   # gp2, gp3, io1, io2
rds_storage_encrypted = true                    # Enable encryption

# Database Configuration
rds_database_name   = "djangodb"                # Database name
rds_master_username = "dbadmin"                 # Master username
rds_master_password = "YourSecurePassword123!"  # Change this! Use AWS Secrets Manager in production
rds_port            = 5432                      # 5432 for PostgreSQL, 3306 for MySQL

# Network Configuration
rds_allowed_cidr_blocks        = ["10.0.0.0/16"]  # VPC CIDR for access
rds_allowed_security_group_ids = []                # Additional security groups
rds_publicly_accessible        = false             # Never true in production!
rds_multi_az                   = false             # Enable for high availability (costs more)

# Backup & Maintenance
rds_backup_retention_period = 7                    # Days to retain backups
rds_backup_window           = "03:00-04:00"        # UTC time
rds_maintenance_window      = "sun:04:00-sun:05:00"  # UTC time
rds_skip_final_snapshot     = true                 # Set to false for production
rds_deletion_protection     = false                # Set to true for production

# Monitoring
rds_performance_insights_enabled    = false        # Enable for production monitoring
rds_enabled_cloudwatch_logs_exports = ["postgresql"]  # ["postgresql"] or ["error", "general", "slowquery"] for MySQL

# Aurora-Specific Settings (only used when rds_use_aurora = true)
rds_aurora_cluster_instances        = 2            # Number of instances (1 writer + N readers)
rds_aurora_autoscaling_enabled      = false        # Enable autoscaling
rds_aurora_autoscaling_min_capacity = 1            # Minimum read replicas
rds_aurora_autoscaling_max_capacity = 5            # Maximum read replicas

# Custom Database Parameters (optional)
rds_db_parameters = []
# Example custom parameters:
# rds_db_parameters = [
#   {
#     name  = "max_connections"
#     value = "200"
#   },
#   {
#     name  = "shared_buffers"
#     value = "256MB"
#   }
# ]

